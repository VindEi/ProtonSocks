[Unit]
Description=Proton-Socks Userspace WireGuard Multi-Account SOCKS5 Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/proton-socks
ExecStart=/usr/local/bin/proton-socks --config-dir /etc/proton-socks daemon
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535

# Strict userspace sandboxing
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
